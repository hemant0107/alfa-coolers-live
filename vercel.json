{
  "public": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "from": "/about",
      "to": "/about.html",
      "status": 200
    },
    {
      "from": "/products",
      "to": "/products.html",
      "status": 200
    },
    {
      "from": "/contact",
      "to": "/contact.html",
      "status": 200
    },
    {
      "from": "/*",
      "to": "/index.html",
      "status": 200
    }
  ]
}